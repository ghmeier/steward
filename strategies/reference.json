{
  "name": "reference",
  "setup": [
    {
      "type": "assignPeasant",
      "peasant": 1,
      "job": "farm"
    },
    {
      "type": "enactDecree",
      "decree": {
        "id": "granary",
        "petition": "harvest",
        "rules": [
          {
            "when": {
              "kind": "compare",
              "quantity": "grainSeasons",
              "comparison": "above",
              "value": 2
            },
            "policy": "feed"
          }
        ],
        "otherwise": "stockpile"
      }
    },
    {
      "type": "enactDecree",
      "decree": {
        "id": "wood-sales",
        "petition": "wood",
        "rules": [
          {
            "when": {
              "kind": "compare",
              "quantity": "wood",
              "comparison": "below",
              "value": 120
            },
            "policy": "stockpile"
          }
        ],
        "otherwise": "sell"
      }
    },
    {
      "type": "enactDecree",
      "decree": {
        "id": "ore-sales",
        "petition": "ore",
        "rules": [
          {
            "when": {
              "kind": "compare",
              "quantity": "ore",
              "comparison": "below",
              "value": 60
            },
            "policy": "stockpile"
          }
        ],
        "otherwise": "sell"
      }
    },
    {
      "type": "enactDecree",
      "decree": {
        "id": "workforce",
        "petition": "labor",
        "rules": [
          {
            "when": {
              "kind": "compare",
              "quantity": "population",
              "comparison": "below",
              "value": 20
            },
            "policy": "farm"
          }
        ],
        "otherwise": "farming"
      }
    }
  ],
  "reactions": [
    {
      "when": {
        "kind": "compare",
        "quantity": "coin",
        "comparison": "above",
        "value": 250
      },
      "commands": [
        {
          "type": "enactDecree",
          "decree": {
            "id": "wood-sales",
            "petition": "wood",
            "rules": [
              {
                "when": {
                  "kind": "compare",
                  "quantity": "wood",
                  "comparison": "below",
                  "value": 300
                },
                "policy": "stockpile"
              }
            ],
            "otherwise": "sell"
          }
        },
        {
          "type": "enactDecree",
          "decree": {
            "id": "ore-sales",
            "petition": "ore",
            "rules": [
              {
                "when": {
                  "kind": "compare",
                  "quantity": "ore",
                  "comparison": "below",
                  "value": 150
                },
                "policy": "stockpile"
              }
            ],
            "otherwise": "sell"
          }
        }
      ]
    }
  ],
  "purchases": [
    "panel.crown",
    "store.granary1",
    "store.woodshed1",
    "store.oreStore1"
  ],
