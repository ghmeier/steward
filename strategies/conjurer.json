            "policy": "mine"
          },
          {
            "when": {
              "kind": "compare",
              "quantity": "owedWood",
              "comparison": "above",
              "value": 0
            },
            "policy": "forest"
          },
          {
            "when": {
              "kind": "compare",
              "quantity": "owedCoin",
              "comparison": "above",
              "value": 0
