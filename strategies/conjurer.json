              "comparison": "above",
              "value": 0
            },
            "policy": "stockpile"
          }
        ],
        "otherwise": "sell"
      }
    },
    {
      "type": "enactDecree",
      "decree": {
        "id": "wood-sales",
        "petition": "wood",
        "rules": [
          {
            "when": {
              "kind": "compare",
              "quantity": "owedWood",
              "comparison": "above",
              "value": 0
            },
            "policy": "stockpile"
          }
        ],
        "otherwise": "sell"
      }
    },
    {
      "type": "enactDecree",
      "decree": {
        "id": "workforce",
        "petition": "labor",
        "rules": [
          {
            "when": {
              "kind": "compare",
