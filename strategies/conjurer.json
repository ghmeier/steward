  "setup": [
    {
      "type": "enactDecree",
      "decree": {
        "id": "granary",
        "petition": "harvest",
        "rules": [
          {
            "when": {
              "kind": "compare",
              "quantity": "grainSeasons",
              "comparison": "above",
              "value": 2
            },
            "policy": "feed"
          }
        ],
        "otherwise": "stockpile"
      }
    },
    {
      "type": "enactDecree",
      "decree": {
        "id": "ore-sales",
        "petition": "ore",
        "rules": [
          {
            "when": {
